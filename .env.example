# Names of Modal Secrets required by modal_app.py.
# These are not loaded from this file — they live in Modal (`modal secret create ...`).
# This file just documents which Secrets must exist.

# HuggingFace token with access to the target model.
# Create at: https://huggingface.co/settings/tokens
#   modal secret create huggingface-secret HF_TOKEN=hf_xxxxx
HF_TOKEN=

# Shared API key required by the vLLM server (Bearer token).
# Any opaque string is fine; treat it like a password.
#   modal secret create vllm-api VLLM_API_KEY=<random>
VLLM_API_KEY=

# Local dev only (not a Modal Secret) — used by validate.py.
BASE_URL=
API_KEY=

# Self-serve bulk harvest (ACS-245) — wrapper-side note, not a Modal Secret.
# POST /v1/harvest derives the harvest app name as "<modal_app_name>-harvest",
# which matches serving/harvest_offline.py's "acs-<MODEL_ID>-harvest" whenever
# the wrapper registry id equals the shared-registry MODEL_ID the app was
# deployed under. If a wrapper entry uses an alias id, set the app name
# explicitly in MODELS_REGISTRY_JSON, e.g. a "trinity-base" alias would need:
#   "trinity-base": {..., "harvest_app_name": "acs-trinity-truebase-harvest"}

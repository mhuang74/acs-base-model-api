# Copy to .env for local dev. Railway injects these via the dashboard.

# Postgres DSN (Railway sets this automatically when the Postgres add-on is attached).
DATABASE_URL=postgresql://user:pass@localhost:5432/acs_wrapper

# Modal endpoint — the *.modal.run URL of the deployed serve function.
MODAL_BASE_URL=https://<workspace>--acs-llama-405b-serve.example.modal.run

# Shared bearer token vLLM expects (matches the `vllm-api` Modal Secret).
VLLM_API_KEY=replace-me

# Root credential for /admin/* endpoints. Long random.
ADMIN_TOKEN=replace-me-with-long-random

# HF token for downloading the tokenizer (gated repo). Read-scope is enough.
HF_TOKEN=

# Optional
SERVED_MODEL_NAME=meta-llama/Llama-3.1-405B
# Days an unused invite link / invite-by-email stays valid (default 7). Raise for
# a beta where hand-picked invitees may take a while to act.
INVITE_EXPIRY_DAYS=7
MODELS_REGISTRY_JSON={"llama-8b":{"upstream_url":"https://<workspace>--acs-llama-8b-serve.example.modal.run"},"llama-405b":{"upstream_url":"https://<workspace>--acs-llama-405b-serve.example.modal.run"},"trinity-base":{"upstream_url":"https://<workspace>--acs-trinity-base-serve.example.modal.run"}}
LOG_LEVEL=INFO
CHAT_COMPLETIONS_HANDOUT_URL=
LOG_IP=true
# CORS allow-list for the public /v1 API (ACS-146). Comma-separated origins;
# "*" = any origin (default). Credentials are always off, so the cookie-auth
# web/admin/workbench surface is never reachable cross-origin regardless.
CORS_ALLOW_ORIGINS=*
